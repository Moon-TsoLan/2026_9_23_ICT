# 复制为 .env 后按需填写。.env 不入库（见 .gitignore），本文件入库作为字段清单。
ICT_LLM_BASE_URL=
ICT_LLM_API_KEY=
ICT_LLM_MODEL=
DEEPSEEK_API_KEY=

# ---- PostgreSQL（Docker，见 docker-compose.yml）----
# 换库只改 DATABASE_URL / PGDATABASE 这一处，代码与查询不用动
DATABASE_URL=postgresql://ict:ict_dev_pw@localhost:5432/ict_demo
PGHOST=localhost
PGPORT=5432
PGUSER=ict
PGPASSWORD=ict_dev_pw
PGDATABASE=ict_demo

# ---- 服务器连接参数（实例每次重启后 host/port 可能变，只改这里即可）----
ICT_SSH_HOST=
ICT_SSH_PORT=
ICT_SSH_USER=root
ssh_password=
ICT_SSH_KEY=%USERPROFILE%\.ssh\ict_parse_server
# 隧道：本机端口 -> 实例内端口（解析服务 6008、vLLM 6006）
ICT_TUNNEL_LOCAL=6008
ICT_TUNNEL_REMOTE=127.0.0.1:6008
# 主流程访问解析服务的地址（走隧道的本机端口）
ICT_PARSE_URL=http://127.0.0.1:6008
ICT_PARSE_TOKEN=
ICT_PARSE_TIMEOUT=600
ICT_PARSE_RUN_WORKERS=3
# 本地 ParseQueue 同时往 GPU 送几份文档。与服务器 start_parse.sh 的 --workers 相乘：
# 实测档位是 客户端 3 / 服务端 4（见 doc/全链路改造计划.md §10.2）。
ICT_PARSE_MAX_INFLIGHT=3
