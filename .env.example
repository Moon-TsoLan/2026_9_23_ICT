# 复制为 .env 后按需填写。.env 不入库（见 .gitignore），本文件入库作为字段清单。
ICT_LLM_BASE_URL=
ICT_LLM_API_KEY=
ICT_LLM_MODEL=
DEEPSEEK_API_KEY=

# ---- PostgreSQL（Docker，见 docker-compose.yml）----
# 换库只改 DATABASE_URL / PGDATABASE 这一处，代码与查询不用动
DATABASE_URL=postgresql://ict:ict_dev_pw@localhost:5432/ict_demo
PGHOST=localhost
PGPORT=5432
PGUSER=ict
PGPASSWORD=ict_dev_pw
PGDATABASE=ict_demo
